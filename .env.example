APP_NAME=Stremfin
APP_VERSION=0.3.0
SERVER_NAME=Stremfin Jellyfin Bridge
SERVER_ID=stremfin-local
PUBLIC_BASE_URL=http://localhost:3000

# One addon URL, or comma-separated URLs. Example: https://torrentio.strem.fun
STREMIO_ADDON_URL=
STREMIO_ADDON_URLS=
SUBTITLE_ADDON_URLS=

# none, real-debrid, or torbox
DEBRID_PROVIDER=none
REAL_DEBRID_API_KEY=
TORBOX_API_KEY=

# Optional TMDB metadata provider.
# Create your own TMDB credential and keep the real value only in .env.
# Do not commit a real API key or access token to the repository.
# Either TMDB_API_KEY or TMDB_ACCESS_TOKEN is sufficient.
# Client-requested language takes priority; this is only the fallback locale.
TMDB_API_KEY=
TMDB_ACCESS_TOKEN=
TMDB_DEFAULT_LANGUAGE=en-US

DATABASE_PATH=./data/stremfin.db

# Dashboard authentication protects the Stremfin administration UI.
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=admin
DASHBOARD_SESSION_SECRET=replace-with-a-long-random-secret

# Jellyfin / Emby player authentication.
# Keep disabled for the legacy no-password compatibility mode.
# When enabled, clients such as Infuse, VidHub, SenPlayer and Rex must use
# CLIENT_USERNAME and CLIENT_PASSWORD through the normal Jellyfin/Emby login.
CLIENT_AUTH_ENABLED=false
CLIENT_USERNAME=stremfin
CLIENT_PASSWORD=

REQUEST_TIMEOUT_SECONDS=20
