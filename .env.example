APP_NAME=Stremfin
APP_VERSION=0.1.0
SERVER_NAME=Stremfin Jellyfin Bridge
SERVER_ID=stremfin-local
PUBLIC_BASE_URL=http://localhost:3000
# One addon URL, or comma-separated URLs. Example: https://torrentio.strem.fun
STREMIO_ADDON_URL=
STREMIO_ADDON_URLS=
# none, real-debrid, or torbox
DEBRID_PROVIDER=none
REAL_DEBRID_API_KEY=
TORBOX_API_KEY=
# Used when no addon stream is available; replace in production.
FALLBACK_STREAM_URL=https://storage.googleapis.com/gtv-videos-bucket/sample/BigBuckBunny.mp4
REQUEST_TIMEOUT_SECONDS=20
